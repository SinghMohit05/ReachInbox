# Server Environment
NODE_ENV=development
PORT=4000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/reachinbox?schema=public

# Redis Connection
REDIS_URL=redis://localhost:6379

# Elasticsearch Connection
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Slack OAuth Credentials
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback

# Auth Secrets
SESSION_SECRET=replace_with_secure_random_session_secret_at_least_32_characters
JWT_SECRET=replace_with_secure_random_jwt_secret_at_least_32_characters

# Ethereal SMTP Credentials
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your_ethereal_user_here
ETHEREAL_PASSWORD=your_ethereal_password_here

# BullMQ Worker Settings
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# Client Application URL
FRONTEND_URL=http://localhost:5173
